  gradeBand                     String?                           @map("grade_band")
  questionType                  QuestionType                      @map("question_type")
  bloomLevel                    BloomLevel                        @map("bloom_level")
  difficulty                    QuestionDifficulty
  numberOfQuestions             Int                               @map("number_of_questions")
  requiredResourceCount         Int                               @map("required_resource_count")
  requiredLearningStandardCount Int                               @map("required_learning_standard_count")
  scenarioContext               String                            @map("scenario_context")
  prohibitedContent             String[]                          @map("prohibited_content")
  promptVersion                 String                            @default("shelterlab-s6-v1") @map("prompt_version")
  requiresGovernmentData        Boolean                           @default(false) @map("requires_government_data")
  qualityRulesJson              Json                              @map("quality_rules_json")
  status                        QuestionGenerationBlueprintStatus @default(draft)
  version                       Int                               @default(1)
  createdById                   String                            @map("created_by")
  reviewedById                  String?                           @map("reviewed_by")
  createdBy                     User                              @relation("QuestionGenerationBlueprintCreatedBy", fields: [createdById], references: [id])
  reviewedBy                    User?                             @relation("QuestionGenerationBlueprintReviewedBy", fields: [reviewedById], references: [id])
  createdAt                     DateTime                          @default(now()) @map("created_at")
  updatedAt                     DateTime                          @updatedAt @map("updated_at")

  drafts           QuestionDraft[]
  resourceMappings QuestionGenerationBlueprintResource[]
  standardMappings QuestionGenerationBlueprintStandard[]
  datasetMappings  QuestionGenerationBlueprintGovernmentDataset[]

  @@unique([code, version])
  @@index([moduleId])
  @@map("question_generation_blueprint")
}

model QuestionGenerationBlueprintResource {
  blueprintId String                      @map("blueprint_id")
  resourceId  String                      @map("resource_id")
  blueprint   QuestionGenerationBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  resource    CurriculumResource          @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt   DateTime                    @default(now()) @map("created_at")

  @@id([blueprintId, resourceId])
  @@map("question_generation_blueprint_resource")
}

model QuestionGenerationBlueprintStandard {
  blueprintId String                      @map("blueprint_id")
  standardId  String                      @map("standard_id")
  blueprint   QuestionGenerationBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  standard    LearningStandard            @relation(fields: [standardId], references: [id], onDelete: Cascade)
  createdAt   DateTime                    @default(now()) @map("created_at")

  @@id([blueprintId, standardId])
  @@map("question_generation_blueprint_standard")
}

model QuestionGenerationBlueprintGovernmentDataset {
  blueprintId String                      @map("blueprint_id")
  datasetId   String                      @map("dataset_id")
  blueprint   QuestionGenerationBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  dataset     GovernmentDataset           @relation(fields: [datasetId], references: [datasetId], onDelete: Cascade)
  createdAt   DateTime                    @default(now()) @map("created_at")

  @@id([blueprintId, datasetId])
  @@map("question_generation_blueprint_government_dataset")
}

model QuestionDraft {
  id                        String                      @id @default(cuid())
  generationBlueprintId     String                      @map("generation_blueprint_id")
  generationBlueprint       QuestionGenerationBlueprint @relation(fields: [generationBlueprintId], references: [id])
  coursePlanId              String                      @map("course_plan_id")
  coursePlan                CoursePlan                  @relation(fields: [coursePlanId], references: [id])
  moduleId                  String                      @map("module_id")
  version                   Int                         @default(1)
  parentDraftId             String?                     @map("parent_draft_id")
  parentDraft               QuestionDraft?              @relation("QuestionDraftVersions", fields: [parentDraftId], references: [id])
  childVersions             QuestionDraft[]             @relation("QuestionDraftVersions")
  prompt                    String
  questionType              QuestionType                @map("question_type")
  optionsJson               Json                        @map("options_json")
  correctOptionKeys         String[]                    @map("correct_option_keys")
  explanation               String
  sourceResourceIds         String[]                    @map("source_resource_ids")
  sourceExcerptNotes        String?                     @map("source_excerpt_notes")
  learningStandardIds       String[]                    @map("learning_standard_ids")
  governmentDatasetIds      String[]                    @default([]) @map("government_dataset_ids")
  generationMethod          QuestionGenerationMethod    @map("generation_method")
  modelName                 String?                     @map("model_name")
  modelVersion              String?                     @map("model_version")
  providerName              String?                     @map("provider_name")
  providerVersion           String?                     @map("provider_version")
  promptVersion             String?                     @map("prompt_version")
  generationTimestamp       DateTime?                   @map("generation_timestamp")
  factualityCheckStatus     DraftCheckStatus            @default(pending) @map("factuality_check_status")
  sourceAlignmentStatus     DraftCheckStatus            @default(pending) @map("source_alignment_status")
  teacherReviewStatus       QuestionDraftStatus         @default(ai_draft) @map("teacher_review_status")
  teacherRevisionNotes      String?                     @map("teacher_revision_notes")
  riskFlagsJson             Json                        @default("[]") @map("risk_flags_json")
  similarityFlagsJson       Json                        @default("[]") @map("similarity_flags_json")
  unsupportedClaimFlagsJson Json                        @default("[]") @map("unsupported_claim_flags_json")
  bloomLevel                BloomLevel                  @map("bloom_level")
  difficulty                QuestionDifficulty
  confidenceNote            String                      @map("confidence_note")
  createdById               String                      @map("created_by")
  reviewedById              String?                     @map("reviewed_by")
  publishedById             String?                     @map("published_by")
  publishedQuestionId       String?                     @map("published_question_id")
  createdBy                 User                        @relation("QuestionDraftCreatedBy", fields: [createdById], references: [id])
  reviewedBy                User?                       @relation("QuestionDraftReviewedBy", fields: [reviewedById], references: [id])
  publishedBy               User?                       @relation("QuestionDraftPublishedBy", fields: [publishedById], references: [id])
  publishedQuestion         Question?                   @relation("PublishedQuestionDraft", fields: [publishedQuestionId], references: [id])
  createdAt                 DateTime                    @default(now()) @map("created_at")
  updatedAt                 DateTime                    @updatedAt @map("updated_at")
  approvedAt                DateTime?                   @map("approved_at")
  publishedAt               DateTime?                   @map("published_at")

  @@index([generationBlueprintId])
  @@index([coursePlanId])
  @@index([parentDraftId])
  @@index([teacherReviewStatus])
  @@map("question_draft")
}

model StudentResourceProgress {
  id            String             @id @default(cuid())
  studentId     String             @map("student_id")
  resourceId    String             @map("resource_id")
  moduleCode    String             @map("module_code")
  openedAt      DateTime?          @map("opened_at")
  completedAt   DateTime?          @map("completed_at")
  progressState String             @default("assigned") @map("progress_state")
  student       User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  resource      CurriculumResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  @@unique([studentId, resourceId])
  @@index([studentId, moduleCode])
  @@map("student_resource_progress")
}

model AuditLog {
  id                String       @id @default(cuid())
  actorId           String       @map("actor_id")
  actor             User         @relation("ActorAuditLogs", fields: [actorId], references: [id])
  entityType        String       @map("entity_type")
  entityId          String       @map("entity_id")
  observationId     String?      @map("observation_id")
  observation       Observation? @relation(fields: [observationId], references: [observationId])
  action            String
  actorRole         String?      @map("actor_role")
  organizationScope String?      @map("organization_scope")
  courseScope       String?      @map("course_scope")
  correlationId     String?      @map("correlation_id")
  fromStatus        String?      @map("from_status")
  toStatus          String?      @map("to_status")
  changes           Json         @default("{}")
  previousState     Json?        @map("previous_state")
  newState          Json?        @map("new_state")
  reason            String?
  createdAt         DateTime     @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_log")
}

model AIProviderConfiguration {
  id            String   @id @default(cuid())
  providerKey   String   @unique @map("provider_key")
  displayName   String   @map("display_name")
  mode          String
  enabled       Boolean  @default(false)
  configuration Json     @default("{}")
  updatedById   String?  @map("updated_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("ai_provider_configuration")
}

model RemediationRecommendation {
  id             String             @id @default(cuid())
  attemptId      String             @map("attempt_id")
  attempt        QuizAttempt        @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  moduleCode     String             @map("module_code")
  standardIds    String[]           @map("standard_ids")
  competencyTags String[]           @map("competency_tags")
  resourceId     String             @map("resource_id")
  resource       CurriculumResource @relation(fields: [resourceId], references: [id])
  priority       Int
  provenanceJson Json               @default("{}") @map("provenance_json")
  assignedAt     DateTime           @default(now()) @map("assigned_at")
  completedAt    DateTime?          @map("completed_at")

  @@unique([attemptId, resourceId])
  @@index([attemptId, moduleCode])
  @@map("remediation_recommendation")
}

// Authenticated classroom accounts are isolated from historical demo User records.
enum LearningRole {
  student
  teacher
}
enum LearningWeekStatus {
  locked
  in_progress
  pending
  completed
}
model LearningAccount {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  displayName String
  role LearningRole
  createdAt DateTime @default(now())
  sessions LearningSession[]
  classes LearningClass[]
  enrollment LearningEnrollment?
  @@map("learning_accounts")
}
model LearningSession {
  tokenHash String @id
  accountId String
  account LearningAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([accountId])
  @@index([expiresAt])
  @@map("learning_sessions")
}
model LearningAuthAttempt {
  key String @id
  count Int
  expiresAt DateTime
  @@index([expiresAt])
  @@map("learning_auth_attempts")
}
model LearningClass {
  id String @id @default(cuid())
  teacherId String @unique
  teacher LearningAccount @relation(fields: [teacherId], references: [id])
  schoolId String
  schoolName String
  county String
  grade String
  studentCount Int
  plannedWeeks Int
  joinCode String @unique
  revision Int @default(0)
  createdAt DateTime @default(now())
  enrollments LearningEnrollment[]
  @@map("learning_classes")
}
model LearningEnrollment {
  id String @id @default(cuid())
  studentId String @unique
  student LearningAccount @relation(fields: [studentId], references: [id])
  classId String
  classroom LearningClass @relation(fields: [classId], references: [id])
  generation Int @default(0)
  createdAt DateTime @default(now())
  weeks LearningWeek[]
  @@index([classId])
  @@map("learning_enrollments")
}
model LearningWeek {
  id String @id @default(cuid())
  enrollmentId String
  enrollment LearningEnrollment @relation(fields: [enrollmentId], references: [id])
  week Int
  status LearningWeekStatus @default(locked)
  version Int @default(0)
  questionSet Json?
  answers Json?
  submittedAt DateTime?
  reviewedAt DateTime?
  reviewedBy String?
  feedback String @default("")
  @@unique([enrollmentId, week])
  @@index([status, submittedAt])
  @@map("learning_weeks")
}
model LearningAudit {
  id String @id @default(cuid())
  actorId String
  classId String
  studentId String?
  action String
  details Json
  createdAt DateTime @default(now())
  @@index([classId, createdAt])
  @@map("learning_audits")
}
