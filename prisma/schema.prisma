model User {
  id        String   @id @default(cuid())
  role      UserRole
  testCode  String   @unique @map("test_code")
  email     String?  @unique
  shelterId String?  @map("shelter_id")
  shelter   Shelter? @relation(fields: [shelterId], references: [shelterId])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  observations                         Observation[]                 @relation("ObserverObservations")
  observationSessionsAsStudent         ObservationSession[]          @relation("ObservationSessionStudent")
  observationSessionsAsTeacher         ObservationSession[]          @relation("ObservationSessionTeacher")
  observationSessionsAsShelterStaff    ObservationSession[]          @relation("ObservationSessionShelterStaff")
  auditLogs                            AuditLog[]                    @relation("ActorAuditLogs")
  learningModulesCreated               LearningModule[]              @relation("ModuleCreatedBy")
  learningModulesReviewed              LearningModule[]              @relation("ModuleReviewedBy")
  questionsCreated                     Question[]                    @relation("QuestionCreatedBy")
  questionsReviewed                    Question[]                    @relation("QuestionReviewedBy")
  quizAttempts                         QuizAttempt[]                 @relation("StudentQuizAttempts")
  researchLicenses                     ResearchLicense[]             @relation("StudentResearchLicenses")
  revokedLicenses                      ResearchLicense[]             @relation("LicenseRevokedBy")
  curriculumResourcesVerified          CurriculumResource[]          @relation("ResourceVerifiedBy")
  coursePlansCreated                   CoursePlan[]                  @relation("CoursePlanCreatedBy")
  questionGenerationBlueprintsCreated  QuestionGenerationBlueprint[] @relation("QuestionGenerationBlueprintCreatedBy")
  questionGenerationBlueprintsReviewed QuestionGenerationBlueprint[] @relation("QuestionGenerationBlueprintReviewedBy")
  questionDraftsCreated                QuestionDraft[]               @relation("QuestionDraftCreatedBy")
  questionDraftsReviewed               QuestionDraft[]               @relation("QuestionDraftReviewedBy")
  questionDraftsPublished              QuestionDraft[]               @relation("QuestionDraftPublishedBy")
  teacherCourseAuthorizations          TeacherCourseAuthorization[]  @relation("TeacherCourseAuthorizationTeacher")
  courseAuthorizationsGranted          TeacherCourseAuthorization[]  @relation("TeacherCourseAuthorizationGrantedBy")
  studentResourceProgress              StudentResourceProgress[]

  @@map("app_user")
}

model Shelter {
  shelterId String   @id @map("shelter_id")
  name      String
  county    String
  city      String
  zones     String[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dogs                Dog[]
  users               User[]
  observationMissions ObservationMission[]

  @@map("shelter")
}

model Dog {
  dogId          String         @id @default(cuid()) @map("dog_id")
  shelterId      String         @map("shelter_id")
  shelter        Shelter        @relation(fields: [shelterId], references: [shelterId])
  publicName     String         @map("public_name")
  sex            Sex
  ageBand        AgeBand        @map("age_band")
  zone           String
  riskFlag       RiskFlag       @default(none) @map("risk_flag")
  adoptionStatus AdoptionStatus @default(unavailable) @map("adoption_status")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  observations              Observation[]
  observationSessions       ObservationSession[]
  observationMissions       ObservationMission[]
  evidenceTimeline          EvidenceTimelineEntry[]
  evidenceProfiles          DogEvidenceProfile[]
  professionalNotes         ShelterProfessionalNote[]
  publishedAdoptionEvidence PublishedAdoptionEvidence[]
  adoptionProfiles          AdoptionProfile[]
  adoptionTimeline          AdoptionTimelineEvent[]

  @@index([shelterId])
  @@map("dog")
}

model CurriculumModule {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  description String
  tags        String[]
  sortOrder   Int      @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  quizQuestions QuizQuestion[]

  @@map("curriculum_module")
}

model QuizQuestion {
  id                  String              @id @default(cuid())
  moduleId            String              @map("module_id")
  module              CurriculumModule    @relation(fields: [moduleId], references: [id])
  prompt              String
  options             Json
  correctOptionIndex  Int                 @map("correct_option_index")
  curriculumTags      String[]            @map("curriculum_tags")
  governmentDatasetId String?             @map("government_dataset_id")
  governmentDataset   GovernmentDataset?  @relation(fields: [governmentDatasetId], references: [datasetId])
  teacherReviewStatus TeacherReviewStatus @default(pending) @map("teacher_review_status")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  @@unique([moduleId, prompt])
  @@index([moduleId])
  @@index([governmentDatasetId])
  @@map("quiz_question")
}

model LearningModule {
  id               String       @id @default(cuid())
  code             String       @unique
  title            String
  description      String
  moduleOrder      Int          @map("module_order")
  estimatedMinutes Int          @map("estimated_minutes")
  passingScore     Int          @map("passing_score")
  status           ModuleStatus @default(draft)
  version          Int          @default(1)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  publishedAt      DateTime?    @map("published_at")
  createdById      String?      @map("created_by")
  reviewedById     String?      @map("reviewed_by")
  createdBy        User?        @relation("ModuleCreatedBy", fields: [createdById], references: [id])
  reviewedBy       User?        @relation("ModuleReviewedBy", fields: [reviewedById], references: [id])

  standards                    LearningModuleStandard[]
  questions                    Question[]
  requirements                 QuizBlueprintModuleRequirement[]
  resourceMappings             CurriculumResourceLearningModule[]
  courseWeeks                  CourseWeek[]
  questionGenerationBlueprints QuestionGenerationBlueprint[]

  @@map("learning_module")
}

model LearningStandard {
  id                      String                 @id @default(cuid())
  jurisdiction            String
  curriculumName          String                 @map("curriculum_name")
  subject                 String
  educationLevel          String                 @map("education_level")
  gradeBand               String                 @map("grade_band")
  learningContentCode     String                 @map("learning_content_code")
  learningContentText     String                 @map("learning_content_text")
  learningPerformanceCode String                 @map("learning_performance_code")
  learningPerformanceText String                 @map("learning_performance_text")
  coreCompetencyCode      String                 @map("core_competency_code")
  coreCompetencyText      String                 @map("core_competency_text")
  sourceAgency            String                 @map("source_agency")
  governmentDatasetId     String?                @map("government_dataset_id")
  governmentDataset       GovernmentDataset?     @relation(fields: [governmentDatasetId], references: [datasetId])
  sourceUrl               String                 @map("source_url")
  version                 String
  status                  LearningStandardStatus @default(demo_reference)
  tags                    String[]
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")

  modules                              LearningModuleStandard[]
  questions                            QuestionLearningStandard[]
  resourceMappings                     CurriculumResourceLearningStandard[]
  questionGenerationBlueprintStandards QuestionGenerationBlueprintStandard[]
  inquiryProjects                      InquiryProjectLearningStandard[]

  @@index([governmentDatasetId])
  @@map("learning_standard")
}

model LearningModuleStandard {
  moduleId   String           @map("module_id")
  standardId String           @map("standard_id")
  module     LearningModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  standard   LearningStandard @relation(fields: [standardId], references: [id], onDelete: Cascade)

  @@id([moduleId, standardId])
  @@map("learning_module_standard")
}

model Question {
  id               String             @id @default(cuid())
  moduleId         String             @map("module_id")
  module           LearningModule     @relation(fields: [moduleId], references: [id])
  questionType     QuestionType       @map("question_type")
  prompt           String
  explanation      String
  difficulty       QuestionDifficulty
  status           QuestionStatus     @default(draft)
  version          Int                @default(1)
  sourceType       QuestionSourceType @map("source_type")
  sourceDatasetId  String?            @map("source_dataset_id")
  sourceDataset    GovernmentDataset? @relation("QuestionSourceDataset", fields: [sourceDatasetId], references: [datasetId])
  sourceReference  String?            @map("source_reference")
  copyrightNote    String?            @map("copyright_note")
  parentQuestionId String?            @map("parent_question_id")
  parentQuestion   Question?          @relation("QuestionVersions", fields: [parentQuestionId], references: [id])
  versions         Question[]         @relation("QuestionVersions")
  createdById      String?            @map("created_by")
  reviewedById     String?            @map("reviewed_by")
  reviewedBy       User?              @relation("QuestionReviewedBy", fields: [reviewedById], references: [id])
  createdBy        User?              @relation("QuestionCreatedBy", fields: [createdById], references: [id])
  reviewReason     String?            @map("review_reason")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  approvedAt       DateTime?          @map("approved_at")

  options          QuestionOption[]
  standards        QuestionLearningStandard[]
  attemptQuestions QuizAttemptQuestion[]
  resourceMappings CurriculumResourceQuestion[]
  sourceDrafts     QuestionDraft[]              @relation("PublishedQuestionDraft")
  datasetMappings  QuestionGovernmentDataset[]

  @@index([moduleId])
  @@index([status])
  @@index([sourceDatasetId])
  @@map("question")
}

model QuestionOption {
  id          String   @id @default(cuid())
  questionId  String   @map("question_id")
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionKey   String   @map("option_key")
  optionText  String   @map("option_text")
  isCorrect   Boolean  @map("is_correct")
  explanation String?
  optionOrder Int      @map("option_order")

  @@unique([questionId, optionKey])
  @@map("question_option")
}

model QuestionLearningStandard {
  questionId String           @map("question_id")
  standardId String           @map("standard_id")
  question   Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  standard   LearningStandard @relation(fields: [standardId], references: [id], onDelete: Cascade)

  @@id([questionId, standardId])
  @@map("question_learning_standard")
}

model QuizBlueprint {
  id                 String          @id @default(cuid())
  code               String
  title              String
  educationLevel     String          @map("education_level")
  version            Int             @default(1)
  status             BlueprintStatus @default(draft)
  totalQuestions     Int             @map("total_questions")
  timeLimitMinutes   Int             @map("time_limit_minutes")
  passingScore       Int             @map("passing_score")
  maxAttempts        Int             @map("max_attempts")
  cooldownMinutes    Int             @map("cooldown_minutes")
  randomizeQuestions Boolean         @default(true) @map("randomize_questions")
  randomizeOptions   Boolean         @default(true) @map("randomize_options")
  createdById        String?         @map("created_by")
  publishedAt        DateTime?       @map("published_at")

  requirements     QuizBlueprintModuleRequirement[]
  attempts         QuizAttempt[]
  licenses         ResearchLicense[]
  resourceMappings CurriculumResourceQuizBlueprint[]

  @@unique([code, version])
  @@map("quiz_blueprint")
}

model QuizBlueprintModuleRequirement {
  blueprintId            String         @map("blueprint_id")
  moduleId               String         @map("module_id")
  blueprint              QuizBlueprint  @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  module                 LearningModule @relation(fields: [moduleId], references: [id])
  requiredQuestionCount  Int            @map("required_question_count")
  minimumModuleScore     Int            @map("minimum_module_score")
  difficultyDistribution Json           @map("difficulty_distribution")

  @@id([blueprintId, moduleId])
  @@map("quiz_blueprint_module_requirement")
}

model QuizAttempt {
  id                   String            @id @default(cuid())
  studentId            String            @map("student_id")
  student              User              @relation("StudentQuizAttempts", fields: [studentId], references: [id])
  blueprintId          String            @map("blueprint_id")
  blueprint            QuizBlueprint     @relation(fields: [blueprintId], references: [id])
  blueprintVersion     Int               @map("blueprint_version")
  startedAt            DateTime          @default(now()) @map("started_at")
  submittedAt          DateTime?         @map("submitted_at")
  expiresAt            DateTime          @map("expires_at")
  status               QuizAttemptStatus @default(in_progress)
  totalScore           Int?              @map("total_score")
  moduleScoresJson     Json              @default("{}") @map("module_scores_json")
  attemptNumber        Int               @map("attempt_number")
  integrityFlagsJson   Json?             @map("integrity_flags_json")
  competencyScoresJson Json              @default("{}") @map("competency_scores_json")
  evidenceSnapshotJson Json              @default("{}") @map("evidence_snapshot_json")

  attemptQuestions           QuizAttemptQuestion[]
  license                    ResearchLicense?
  remediationRecommendations RemediationRecommendation[]

  @@index([studentId, blueprintId])
  @@map("quiz_attempt")
}

model QuizAttemptQuestion {
  id                           String              @id @default(cuid())
  attemptId                    String              @map("attempt_id")
  attempt                      QuizAttempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId                   String              @map("question_id")
  question                     Question            @relation(fields: [questionId], references: [id])
  questionVersion              Int                 @map("question_version")
  moduleCode                   String              @map("module_code")
  promptSnapshot               String              @map("prompt_snapshot")
  explanationSnapshot          String              @map("explanation_snapshot")
  optionsSnapshotJson          Json                @map("options_snapshot_json")
  questionOrder                Int                 @map("question_order")
  resourceIdsSnapshot          String[]            @default([]) @map("resource_ids_snapshot")
  learningStandardIdsSnapshot  String[]            @default([]) @map("learning_standard_ids_snapshot")
  governmentDatasetIdsSnapshot String[]            @default([]) @map("government_dataset_ids_snapshot")
  verificationSnapshotJson     Json                @default("{}") @map("verification_snapshot_json")
  providerNameSnapshot         String?             @map("provider_name_snapshot")
  providerVersionSnapshot      String?             @map("provider_version_snapshot")
  promptVersionSnapshot        String?             @map("prompt_version_snapshot")
  bloomLevelSnapshot           BloomLevel?         @map("bloom_level_snapshot")
  difficultySnapshot           QuestionDifficulty? @map("difficulty_snapshot")

  answers QuizAnswer[]

  @@index([attemptId])
  @@map("quiz_attempt_question")
}

model QuizAnswer {
  id                String              @id @default(cuid())
  attemptQuestionId String              @map("attempt_question_id")
  attemptQuestion   QuizAttemptQuestion @relation(fields: [attemptQuestionId], references: [id], onDelete: Cascade)
  selectedOptionIds String[]            @map("selected_option_ids")
  isCorrect         Boolean             @map("is_correct")
  scoreAwarded      Int                 @map("score_awarded")
  answeredAt        DateTime            @default(now()) @map("answered_at")

  @@map("quiz_answer")
}

model ResearchLicense {
  id                  String                @id @default(cuid())
  studentId           String                @map("student_id")
  student             User                  @relation("StudentResearchLicenses", fields: [studentId], references: [id])
  licenseLevel        LicenseLevel          @default(level_1) @map("license_level")
  blueprintId         String                @map("blueprint_id")
  blueprint           QuizBlueprint         @relation(fields: [blueprintId], references: [id])
  blueprintVersion    Int                   @map("blueprint_version")
  qualifyingAttemptId String                @unique @map("qualifying_attempt_id")
  qualifyingAttempt   QuizAttempt           @relation(fields: [qualifyingAttemptId], references: [id])
  status              ResearchLicenseStatus @default(active)
  issuedAt            DateTime              @map("issued_at")
  expiresAt           DateTime              @map("expires_at")
  revokedAt           DateTime?             @map("revoked_at")
  revokedById         String?               @map("revoked_by")
  revokedBy           User?                 @relation("LicenseRevokedBy", fields: [revokedById], references: [id])
  revocationReason    String?               @map("revocation_reason")
  certificateCode     String                @unique @map("certificate_code")
  certificateVersion  Int                   @default(1) @map("certificate_version")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  @@index([studentId, status])
  @@map("research_license")
}

model Observation {
  observationId         String                 @id @default(cuid()) @map("observation_id")
  dogId                 String                 @map("dog_id")
  dog                   Dog                    @relation(fields: [dogId], references: [dogId])
  observerId            String                 @map("observer_id")
  observer              User                   @relation("ObserverObservations", fields: [observerId], references: [id])
  timestamp             DateTime
  behaviorCode          BehaviorCode           @map("behavior_code")
  durationSec           Int                    @map("duration_sec")
  context               String
  notes                 String?
  mediaUrl              String?                @map("media_url")
  mediaChecksum         String?                @map("media_checksum")
